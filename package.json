{
  "name": "vue-ionic-budget-app",
  "version": "1.2.0",
  "author": {
    "name": "AndreiDetenkov",
    "email": "a.detenkov@gmail.com"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint --ext .ts,.vue src/ --fix",
    "typecheck": "vue-tsc -b --noEmit",
    "sync": "ionic capacitor sync android",
    "open": "ionic capacitor open android",
    "run": "ionic capacitor run android -l --external --target=676239e9",
    "run:android": "ionic capacitor run android --target=Pixel_9 --livereload --external",
    "release": "pnpx changelogen@latest --release --push",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor-firebase/authentication": "^8.6.0",
    "@capacitor/android": "^8.6.2",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.2",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.6.2",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/share": "^8.0.3",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/core": "^8.8.19",
    "@ionic/vue": "^8.8.19",
    "@ionic/vue-router": "^8.8.19",
    "dayjs": "^1.11.23",
    "firebase": "^13.4.0",
    "ionicons": "^8.1.1",
    "pinia": "4.1.0",
    "vue": "3.5.46",
    "vue-router": "^5.5.1"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.2",
    "@eslint/js": "^10.0.1",
    "@ionic/prettier-config": "4.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.6.0",
    "baseline-browser-mapping": "^2.11.39",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "globals": "^17.14.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^31.0.1",
    "lint-staged": "^17.6.2",
    "prettier": "^3.10.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
    "vite": "^8.3.8",
    "vitest": "^5.1.1",
    "vue-tsc": "^3.3.14"
  },
  "prettier": "@ionic/prettier-config",
  "engines": {
    "node": "^24",
    "pnpm": "^11"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html}": "prettier --write"
  }
}
