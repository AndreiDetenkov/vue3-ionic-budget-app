{
  "name": "vue-ionic-budget-app",
  "version": "1.0.0",
  "author": {
    "name": "AndreiDetenkov",
    "email": "a.detenkov@gmail.com"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "pnpm vite",
    "build": "vite build",
    "preview": "vite preview",
    "test:unit": "vitest",
    "lint": "eslint --ext .ts,.vue src/ --fix",
    "typecheck": "vue-tsc -b --noEmit",
    "sync": "ionic capacitor sync android",
    "open": "ionic capacitor open android",
    "run": "ionic capacitor run android -l --external --target=676239e9",
    "run:android": "ionic capacitor run android --target=Pixel_9 --livereload --external",
    "release": "pnpx changelogen@latest --release --push",
    "format": "prettier --write src/",
    "prepare": "husky"
  },
  "dependencies": {
    "@capacitor/android": "^8.5.3",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.5.3",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/ios": "^8.5.3",
    "@capacitor/keyboard": "^8.0.6",
    "@capacitor/status-bar": "^8.0.4",
    "@ionic/core": "^8.8.19",
    "@ionic/vue": "^8.8.19",
    "@ionic/vue-router": "^8.8.19",
    "@supabase/supabase-js": "^2.117.3",
    "dayjs": "^1.11.23",
    "ionicons": "^8.1.0",
    "pinia": "4.0.3",
    "vue": "3.5.43",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^3.0.5",
    "@capacitor/cli": "^8.5.3",
    "@eslint/js": "^9.39.5",
    "@ionic/prettier-config": "4.0.0",
    "@types/node": "^24.19.2",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/devtools": "^8.2.1",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "baseline-browser-mapping": "^2.11.28",
    "eslint": "^9.39.5",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^26.1.0",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10",
    "supabase": "^2.120.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1",
    "vite": "8.0.16",
    "vitest": "^5.0.3",
    "vue-tsc": "^3.3.13"
  },
  "prettier": "@ionic/prettier-config",
  "engines": {
    "node": "^24",
    "pnpm": "^11"
  },
  "lint-staged": {
    "*.{ts,vue,js,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,scss,html}": "prettier --write"
  }
}
